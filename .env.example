# Copie para .env e preencha. O .env nunca vai para o GitHub.

# Pelo menos uma key e obrigatoria. Pegue em https://console.groq.com/keys
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Opcionais
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_MS=20000
COOLDOWN_MS=5000

# Local so. No Render a porta e definida automaticamente - nao configure la.
PORT=3000
